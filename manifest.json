{
  "manifest_version": 3,
  "name": "News Feed Remover",
  "version": "1.0.0",
  "description": "Hide YouTube recommendations and the home feeds on X (Twitter), Instagram, and LinkedIn. YouTube ads auto-skip; Facebook shows goal reminders before its feed. Toggle each site independently.",
  "author": "News Feed Remover",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.linkedin.com/*"
  ],
  "action": {
    "default_title": "News Feed Remover",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.linkedin.com/*"
      ],
      "exclude_matches": [
        "*://studio.youtube.com/*",
        "*://*.studio.youtube.com/*",
        "*://music.youtube.com/*",
        "*://*.music.youtube.com/*",
        "*://*.facebook.com/messages/*",
        "*://*.facebook.com/marketplace/*"
      ],
      "js": ["content/sites.js", "content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
